// fastfetch - muted, matches waybar/rofi/swaync
// logo: first frame of the clapping-cat video; ff.sh plays the rest on top (run via `fastfetch` alias)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "~/.config/fastfetch/logo.png",
    "width": 26,
    "height": 16,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;110;117;133",     // dim grey   #6e7585
      "title": "38;2;169;194;214",    // steel blue #a9c2d6
      "output": "38;2;201;204;212"    // soft white #c9ccd4
    },
    "key": { "width": 10 },
    "bar": {
      "char": { "elapsed": "━", "total": "━" },
      "border": null,
      "color": { "elapsed": "38;2;169;194;214", "total": "38;2;58;62;74" },
      "width": 12
    },
    "percent": { "type": ["num", "bar"], "color": { "green": "38;2;169;194;214", "yellow": "38;2;216;185;138", "red": "38;2;208;138;138" } }
  },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;58;62;74m──────────────────────────" },
    { "type": "os",       "key": "os",     "format": "{name} {arch}" },
    { "type": "kernel",   "key": "kernel", "format": "{release}" },
    { "type": "wm",       "key": "wm",     "format": "{pretty-name} {version}" },
    { "type": "terminal", "key": "term",   "format": "{pretty-name}" },
    // ff.sh exports FF_SHELL (fastfetch alone would see ff.sh's bash); plain runs use $SHELL
    { "type": "command",  "key": "shell",  "text": "printf %s \"${FF_SHELL:-$(basename \"$SHELL\")}\"" },
    { "type": "uptime",   "key": "uptime" },
    { "type": "packages", "key": "pkgs",   "format": "{all}" },
    "break",
    { "type": "cpu",      "key": "cpu",    "format": "{name}", "temp": false },
    { "type": "gpu",      "key": "gpu",    "format": "{name}", "hideType": "none" },
    { "type": "memory",   "key": "ram",    "format": "{used} / {total}  {percentage-bar}" },
    { "type": "disk",     "key": "disk",   "folders": "/", "format": "{size-used} / {size-total}  {size-percentage-bar}" },
    { "type": "battery",  "key": "battery","format": "{capacity-bar} {capacity}  {status}" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
  ]
}
