/* glass - muted, low-contrast launcher matching the waybar */

configuration {
    show-icons:          true;
    icon-theme:          "breeze-dark";
    display-drun:        "";
    drun-display-format: "{name}";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    font:       "GeistMono Nerd Font Medium 12";

    bg:         #101117c7;
    bg-input:   #ffffff0a;
    bg-sel:     #ffffff12;
    line:       #ffffff14;
    fg:         #c9ccd4;
    fg-dim:     #6e7585;
    accent:     #a9c2d6;

    background-color: transparent;
    text-color:       @fg;
    margin:  0;
    padding: 0;
    spacing: 0;
}

window {
    location:         center;
    anchor:           center;
    width:            640px;
    background-color: @bg;
    border:           1px;
    border-color:     @line;
    border-radius:    18px;
}

mainbox {
    padding:  14px;
    spacing:  10px;
    children: [ inputbar, message, listview ];
}

inputbar {
    padding:          13px 16px;
    spacing:          12px;
    background-color: @bg-input;
    border-radius:    12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:     @accent;
    vertical-align: 0.5;
}

entry {
    font:              "GeistMono Nerd Font 14";
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    cursor:            text;
    vertical-align:    0.5;
}

message {
    padding:          8px 14px;
    border-radius:    10px;
    background-color: @bg-input;
}
textbox { text-color: @fg-dim; }

listview {
    lines:        8;
    columns:      1;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
    cycle:        true;
}

element {
    padding:       9px 12px;
    spacing:       14px;
    border-radius: 10px;
    cursor:        pointer;
}

element normal.normal,
element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active,
element alternate.active { text-color: @accent; }
element normal.urgent,
element alternate.urgent { text-color: #d08a8a; }

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: @bg-sel;
    text-color:       #e2e4ea;
}

element-icon {
    size:           26px;
    vertical-align: 0.5;
    cursor:         inherit;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    highlight:        bold #a9c2d6;
    cursor:           inherit;
}

/* dmenu-style menus (power menu etc.) */
error-message {
    padding:          16px;
    background-color: @bg;
    border-radius:    18px;
}
