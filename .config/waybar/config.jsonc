// Full-width flat bar - muted / low contrast
{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,
  "modules-left": [
    "custom/logo",
    "ext/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/media",
    "cpu",
    "memory",
    "temperature",
    "pulseaudio",
    "pulseaudio#microphone",
    "backlight",
    "network",
    "battery",
    "custom/notification",
    "custom/power"
  ],
  "custom/logo": {
    "format": "󰣇",
    "tooltip": false,
    "on-click": "rofi -show drun -show-icons"
  },
  "hyprland/window": {
    "format": "{title}",
    "max-length": 48,
    "separate-outputs": true,
    "rewrite": {
      "": "desktop"
    }
  },
  "clock": {
    "format": "<span color='#7d8494'>{0:%a %d %b}</span>   <span color='#e2e4ea' weight='bold'>{0:%H:%M}</span>",
    "format-alt": "<span color='#7d8494'>{0:%A, %d %B %Y}</span>   <span color='#e2e4ea' weight='bold'>{0:%H:%M:%S}</span>",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c9ccd4'><b>{}</b></span>",
        "days": "<span color='#9aa0ad'>{}</span>",
        "weekdays": "<span color='#7d8494'><b>{}</b></span>",
        "today": "<span color='#a9c2d6'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "cpu": {
    "format": "<span color='#6e7585' size='small' weight='bold'>CPU</span> {usage}%",
    "interval": 5,
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "ghostty -e btop"
  },
  "memory": {
    "format": "<span color='#6e7585' size='small' weight='bold'>RAM</span> {used:0.1f}G",
    "interval": 10,
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G",
    "on-click": "ghostty -e btop"
  },
  "temperature": {
    "format": "<span color='#6e7585' size='small' weight='bold'>TEMP</span> {temperatureC}°",
    "critical-threshold": 85
  },
  "pulseaudio": {
    "format": "<span color='#6e7585'>{icon}</span>  {volume}%",
    "format-muted": "<span color='#6e7585'>󰝟</span>  <span color='#6e7585'>muted</span>",
    "format-bluetooth": "<span color='#6e7585'>󰂯</span>  {volume}%",
    "format-muted-bluetooth": "<span color='#6e7585'>󰂲</span>  <span color='#6e7585'>muted</span>",
    "format-icons": {
      "headphone": "󰋋",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "on-click": "~/.config/waybar/scripts/audio-click.sh",
    "on-click-right": "env GTK_THEME=Glass pavucontrol",
    "scroll-step": 5,
    "tooltip-format": "{desc}\nclick: mute · double-click: switch output · right-click: mixer"
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span color='#6e7585'>󰍬</span>  {volume}%",
    "format-source-muted": "<span color='#6e7585'>󰍭</span>",
    "on-click": "pamixer --default-source -t",
    "on-click-right": "env GTK_THEME=Glass pavucontrol",
    "on-scroll-up": "pamixer --default-source -i 5",
    "on-scroll-down": "pamixer --default-source -d 5",
    "tooltip-format": "Mic: {desc}"
  },
  "backlight": {
    "format": "<span color='#6e7585'>{icon}</span>  {percent}%",
    "format-icons": [
      "󰃞",
      "󰃟",
      "󰃠"
    ],
    "on-scroll-up": "brightnessctl set 5%+",
    "on-scroll-down": "brightnessctl set 5%-"
  },
  "network": {
    "interface": "wlp9s0",
    "format-wifi": "<span color='#6e7585'>{icon}</span>  {essid}",
    "format-ethernet": "<span color='#6e7585'>󰈀</span>  wired",
    "format-linked": "<span color='#6e7585'>󰤫</span>  no ip",
    "format-disconnected": "<span color='#6e7585'>󰤮</span>  <span color='#6e7585'>offline</span>",
    "format-icons": [
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "interval": 5,
    "on-click": "ghostty -e nmtui",
    "tooltip-format": "{essid} ({signalStrength}%)\n{ipaddr}/{cidr} on {ifname}\n {bandwidthUpBytes}   {bandwidthDownBytes}"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "<span color='#6e7585'>{icon}</span>  {capacity}%",
    "format-charging": "<span color='#6e7585'>󰂄</span>  {capacity}%",
    "format-plugged": "<span color='#6e7585'>󰚥</span>  {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁼",
      "󰁾",
      "󰂀",
      "󰁹"
    ],
    "tooltip-format": "{timeTo}"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/scripts/powermenu.sh"
  },
  "custom/notification": {
    "exec": "~/.config/hypr/scripts/notif-status.sh",
    "return-type": "json",
    "escape": true,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂚",
      "dnd-notification": "󰂛",
      "dnd-none": "󰂛",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰂛",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰂛",
      "invisible": "󰈉"
    },
    "tooltip": true,
    "on-click": "swaync-client -t -sw",
    "on-click-right": "~/.config/hypr/scripts/notif-mode.sh cycle"
  },
  "ext/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "ignore-hidden": true,
    "format-icons": {
      "1": "一",
      "2": "二",
      "3": "三"
    },
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'"
  },
  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  }
}
