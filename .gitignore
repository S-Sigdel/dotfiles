# icon themes installed locally (big, not ours)
.local/share/icons/Papirus/
.local/share/icons/Papirus-Dark/
# app-generated icons (wine, jetbrains toolbox) + caches
.local/share/icons/hicolor/
**/icon-theme.cache
# cava writes its own default config + shaders on first run
.config/cava/config
.config/cava/shaders/
.config/cava/themes/
# generated from the wallpaper by hypr/scripts/brave-theme.py
.config/brave-theme/
# editor / manual backups
*.bak
